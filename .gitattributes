# Normalize text files
* text=auto

# Explicit line endings
*.py text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Jupyter Notebooks
*.ipynb text eol=lf

# Data files
*.csv text

# SQL files
*.sql linguist-detectable=true
sql/ linguist-documentation=false

# Binary files
*.pbix binary
